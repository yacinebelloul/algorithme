ALGORITHM sentencesanalyse
VAR
    length :entier;
    Words : entier;
    vowels : entier;
    char: STRING;

    BEGIN
    WRITE('Enter a sentence ends with a point . ');
    REPEAT
    READ("char")
    length := length +1;
    IF (char = 'a' OR char = 'e' OR char = 'i' OR char = 'o' OR char = 'u' OR char = 'y' OR char = 'A' OR char = 'E' OR char = 'I' OR char = 'O' OR char = 'U' OR char = 'Y') THEN
        vowels := vowels +1;
    END_IF
    else IF (char = ' ') THEN
        Words := Words +1;
        
    END_IF 
    UNTIL char = '.'
        WRITE('length' , length);
        WRITE('vowels' , vowels);
        WRITE('Words' , Words );
    END
    
    
    